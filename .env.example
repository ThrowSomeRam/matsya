# Copy to .env (gitignored) and fill in. Never commit a real value.

# A3 master key: wraps every tenant's data key (RFC 3394 AES key wrap). 32 random bytes,
# base64-encoded. Generate one with:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
MATSYA_MASTER_KEY=replace-with-32-random-bytes-base64

# Object storage for the encrypted raw payloads and table parts. Unset MATSYA_S3_ENDPOINT to
# keep them in a local folder (the default; the eval loop uses it). Set it to use MinIO, started
# with: docker compose -f infra/compose.platform.yml up -d (it reads the two keys below).
# The bucket must never have versioning or object lock; the store refuses one that does.
# Needs the platform's "s3" extra (boto3). Keys never go to the bucket: they stay in <root>/keys.
# MATSYA_S3_ENDPOINT=http://127.0.0.1:9000
MATSYA_S3_BUCKET=matsya
MATSYA_S3_ACCESS_KEY=replace-with-an-access-key
MATSYA_S3_SECRET_KEY=replace-with-a-long-random-secret
# Optional prefix inside the bucket; each store root gets its own sub-prefix under it.
# MATSYA_S3_PREFIX=
